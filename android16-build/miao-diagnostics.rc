# Diagnóstico de arranque propio, MIT. Sólo imagen efímera de CI.
# Registro local rotado: sin red, sin credenciales y sin datos de APK del usuario.
on post-fs-data
    mkdir /data/local/tmp 0771 shell shell
    start miao-boot-log
    start miao-boot-errors

service miao-boot-log /system/bin/logcat -b all -v threadtime -f /data/local/tmp/miao-boot.log -r 2048 -n 2
    class core
    user root
    group root log system
    disabled
    oneshot

# Los errores salen también por la consola del núcleo, aunque falle ADB.
service miao-boot-errors /system/bin/logcat -b all -v brief *:E
    class core
    user root
    group root log system
    stdio_to_kmsg
    disabled
    oneshot
